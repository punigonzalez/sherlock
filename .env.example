# Copy to .env for local Docker Compose / app runs (never commit .env)
POSTGRES_DB=logdetective
POSTGRES_USER=logdetective
POSTGRES_PASSWORD=local-dev-only-change-me
# Host port mapped by Compose. Use 5433 when host 5432 is already taken.
POSTGRES_PORT=5433

# Must match POSTGRES_PORT above (host side).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/logdetective
SPRING_DATASOURCE_USERNAME=logdetective
SPRING_DATASOURCE_PASSWORD=local-dev-only-change-me

# --- TuConsultorio consul file ingest (local dual-run) ---
# Absolute paths; allowlist must be the directory containing the log file.
LOGDETECTIVE_INGESTION_ENABLED=true
LOGDETECTIVE_FILE_SOURCE_ID=tuconsultorio-consul
LOGDETECTIVE_FILE_SOURCE_PATH=/Users/punigonzalez/Documents/TuConsultorio/consul/logs/consul.log
LOGDETECTIVE_FILE_SOURCE_ENCODING=UTF-8
LOGDETECTIVE_FILE_SOURCE_ENABLED=true
LOGDETECTIVE_ALLOWLIST_BASE_DIR=/Users/punigonzalez/Documents/TuConsultorio/consul/logs

# Phase 5 API/CLI (local MVP)
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Phase 6 investigation — fake for local demo without OpenAI
LOGDETECTIVE_INVESTIGATION_PROVIDER=fake
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Phase 7 GCP Logging (optional; ADC required when enabled)
LOGDETECTIVE_GCP_LOGGING_ENABLED=false
# GCP_PROJECT_ID=
# LOGDETECTIVE_GCP_FILTER=severity>=ERROR
# LOGDETECTIVE_GCP_IT=false
